@model List<Cochera>
@{
    ViewData["Title"] = "Disponibilidad de cocheras";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Disponibilidad</h1>
    <a asp-action="Index" class="btn btn-link">Ver como lista</a>
</div>

<div class="d-flex gap-3 mb-4">
    <span class="badge bg-success fs-6">Libres: @ViewBag.Libres</span>
    <span class="badge bg-danger fs-6">Ocupadas: @ViewBag.Ocupadas</span>
</div>

<div class="row g-3">
    @foreach (var c in Model)
    {
        var libre = c.Estado == "Libre";
        <div class="col-6 col-md-3 col-lg-2">
            <div class="card text-center border-@(libre ? "success" : "danger")">
                <div class="card-body py-3">
                    <div class="fs-4 fw-bold">@c.Numero</div>
                    <div class="small text-muted">@c.TipoVehiculo?.Descripcion</div>
                    <span class="badge @(libre ? "bg-success" : "bg-danger") mt-2">@c.Estado</span>
                </div>
            </div>
        </div>
    }
</div>

