@model List<Tarifa>
@{
    ViewData["Title"] = "Tarifas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Tarifas</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nueva tarifa</a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Descripción</th>
            <th>Tipo de vehículo</th>
            <th>Unidad</th>
            <th class="text-end">Precio</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr class="@(t.Activa ? "" : "text-muted")">
                <td>@t.Descripcion</td>
                <td>@t.TipoVehiculo?.Descripcion</td>
                <td>Por @t.UnidadTiempo.ToLower()</td>
                <td class="text-end">$ @t.Precio.ToString("N2")</td>
                <td><span class="badge @(t.Activa ? "bg-success" : "bg-secondary")">@(t.Activa ? "Activa" : "Inactiva")</span></td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">No hay tarifas cargadas.</td></tr>
        }
    </tbody>
</table>

