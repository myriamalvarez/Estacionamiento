@model Tarifa

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <input asp-for="Descripcion" class="form-control" />
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="IdTipoVehiculo" class="form-label">Tipo de vehículo</label>
        <select asp-for="IdTipoVehiculo" asp-items="ViewBag.TiposVehiculo" class="form-select">
            <option value="">-- Seleccionar --</option>
        </select>
        <span asp-validation-for="IdTipoVehiculo" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="UnidadTiempo" class="form-label">Unidad de tiempo</label>
        <select asp-for="UnidadTiempo" asp-items="ViewBag.UnidadesTiempo" class="form-select">
            <option value="">-- Seleccionar --</option>
        </select>
        <span asp-validation-for="UnidadTiempo" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Precio" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Precio" class="form-control" />
        </div>
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
</div>
<div class="form-check mb-3">
    <input asp-for="Activa" class="form-check-input" />
    <label asp-for="Activa" class="form-check-label">Activa</label>
</div>

