@{
    ViewData["Title"] = "Historial de estadías";
}

<div id="app" v-cloak>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Historial de estadías</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Ver vehículos dentro</a>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Buscar por patente..."
                   v-model="term" @@input="buscar" />
        </div>
    </div>

    <div v-if="error" class="alert alert-danger">{{ error }}</div>
    <div v-if="cargando" class="text-muted">Cargando...</div>

    <table v-else class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Patente</th>
                <th>Cochera</th>
                <th>Ingreso</th>
                <th>Egreso</th>
                <th>Estado</th>
                <th class="text-end">Monto</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr v-for="e in items" :key="e.id">
                <td><strong>{{ e.patente }}</strong></td>
                <td>{{ e.cochera }}</td>
                <td>{{ e.ingreso }}</td>
                <td>{{ e.egreso ?? '—' }}</td>
                <td>
                    <span class="badge" :class="e.activa ? 'bg-primary' : 'bg-secondary'">{{ e.activa ? 'En curso' : 'Finalizada' }}</span>
                    <span v-if="e.conAbono" class="badge bg-info text-dark">Abono</span>
                </td>
                <td class="text-end">
                    <span v-if="e.monto !== null">$ {{ Number(e.monto).toLocaleString('es-AR', { minimumFractionDigits: 2 }) }}</span>
                    <span v-else class="text-muted">—</span>
                </td>
                <td class="text-end">
                    <a :href="urlBase + 'Details/' + e.id" class="btn btn-sm btn-outline-primary">Ver</a>
                </td>
            </tr>
            <tr v-if="items.length === 0">
                <td colspan="7" class="text-center text-muted">No se encontraron estadías.</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <small class="text-muted">{{ total }} estadía(s) — página {{ pagina }} de {{ totalPaginas || 1 }}</small>
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item" :class="{ disabled: pagina <= 1 }">
                    <button class="page-link" @@click="irAPagina(pagina - 1)">Anterior</button>
                </li>
                <li class="page-item" :class="{ disabled: pagina >= totalPaginas }">
                    <button class="page-link" @@click="irAPagina(pagina + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    items: [], total: 0, pagina: 1, tamanioPagina: 10, totalPaginas: 0,
                    term: '', cargando: false, error: '', temporizador: null,
                    urlBase: '@Url.Content("~/Estadia/")'
                };
            },
            mounted() { this.cargar(); },
            methods: {
                async cargar() {
                    this.cargando = true;
                    try {
                        const params = new URLSearchParams({
                            pagina: this.pagina, tamanioPagina: this.tamanioPagina, term: this.term
                        });
                        const resp = await fetch('@Url.Action("HistorialJson", "Estadia")?' + params);
                        if (!resp.ok) throw new Error('Error ' + resp.status);
                        const data = await resp.json();
                        this.error = '';
                        this.items = data.items;
                        this.total = data.total;
                        this.totalPaginas = data.totalPaginas;
                    } catch (e) {
                        this.error = 'No se pudo cargar el listado (' + e.message + ').';
                        this.items = [];
                    } finally {
                        this.cargando = false;
                    }
                },
                irAPagina(n) {
                    if (n < 1 || n > this.totalPaginas) return;
                    this.pagina = n;
                    this.cargar();
                },
                buscar() {
                    clearTimeout(this.temporizador);
                    this.temporizador = setTimeout(() => { this.pagina = 1; this.cargar(); }, 300);
                }
            }
        }).mount('#app');
    </script>
}

