@{
    ViewData["Title"] = "Inicio";
}

<h1 class="mb-4">Panel principal</h1>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card text-bg-success h-100">
            <div class="card-body">
                <h6 class="card-title">Cocheras libres</h6>
                <p class="display-6 mb-0">@ViewBag.CocherasLibres</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-bg-secondary h-100">
            <div class="card-body">
                <h6 class="card-title">Cocheras ocupadas</h6>
                <p class="display-6 mb-0">@ViewBag.CocherasOcupadas</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <h6 class="card-title">Vehículos adentro</h6>
                <p class="display-6 mb-0">@ViewBag.EstadiasActivas</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-bg-info h-100">
            <div class="card-body">
                <h6 class="card-title">Vehículos registrados</h6>
                <p class="display-6 mb-0">@ViewBag.VehiculosRegistrados</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-3">
        <a class="btn btn-outline-primary w-100" asp-controller="Estadia" asp-action="Ingreso">Registrar ingreso</a>
    </div>
    <div class="col-md-3">
        <a class="btn btn-outline-primary w-100" asp-controller="Estadia" asp-action="Index">Vehículos adentro</a>
    </div>
    <div class="col-md-3">
        <a class="btn btn-outline-primary w-100" asp-controller="Cochera" asp-action="Disponibilidad">Ver disponibilidad</a>
    </div>
    <div class="col-md-3">
        <a class="btn btn-outline-primary w-100" asp-controller="Vehiculo" asp-action="Index" asp-route-nuevo="1">Nuevo vehículo</a>
    </div>
</div>

