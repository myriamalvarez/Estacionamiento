@model Pago
@{
    ViewData["Title"] = "Registrar pago";
    var estadia = ViewBag.Estadia as Estadia;
}

<h1>Registrar pago</h1>

@if (estadia != null)
{
    <p class="text-muted">Estadía de <strong>@estadia.Vehiculo?.Patente</strong> — ingreso @estadia.FechaHoraIngreso.ToString("dd/MM/yyyy HH:mm")</p>
}

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="IdEstadia" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Monto" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="Monto" class="form-control" />
            </div>
            <span asp-validation-for="Monto" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="MetodoPago" class="form-label"></label>
            <select asp-for="MetodoPago" class="form-select">
                <option value="">-- Seleccionar --</option>
                <option>Efectivo</option>
                <option>Transferencia</option>
                <option>Tarjeta de débito</option>
                <option>Tarjeta de crédito</option>
            </select>
            <span asp-validation-for="MetodoPago" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Comprobante digital (opcional)</label>
        <input type="file" name="archivoComprobante" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
        @Html.ValidationMessage("archivoComprobante", new { @class = "text-danger" })
        <div class="form-text">PDF, JPG o PNG, hasta 5 MB.</div>
    </div>

    <button type="submit" class="btn btn-success">Registrar pago</button>
    <a asp-controller="Estadia" asp-action="Details" asp-route-id="@Model.IdEstadia" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

